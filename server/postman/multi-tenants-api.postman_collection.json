{
  "info": {
    "name": "Multi-Tenants API",
    "description": "Auth, Organizations, and Teams API for the multi-tenants server.\n\n**Setup:**\n1. Import this collection\n2. Import the environment file (optional)\n3. Run **Register** → check server logs for verification link → **Verify Email**\n4. Run **Login** — tokens are saved automatically to collection variables",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "verificationToken", "value": "" },
    { "key": "orgId", "value": "" },
    { "key": "teamId", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "teamMemberId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-email"
          }
        },
        {
          "name": "Resend Verification",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/resend-verification"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "Create Organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) pm.collectionVariables.set('orgId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corp\",\n  \"slug\": \"acme-corp\",\n  \"description\": \"Our main organization\",\n  \"website\": \"https://acme.example.com\"\n}"
            },
            "url": "{{baseUrl}}/organizations"
          }
        },
        {
          "name": "List My Organizations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations"
          }
        },
        {
          "name": "Get Organization by Slug",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations/slug/acme-corp"
          }
        },
        {
          "name": "Get Organization by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations/{{orgId}}"
          }
        },
        {
          "name": "Update Organization",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corporation\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": "{{baseUrl}}/organizations/{{orgId}}"
          }
        },
        {
          "name": "Delete Organization",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/organizations/{{orgId}}"
          }
        },
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations/{{orgId}}/members"
          }
        },
        {
          "name": "Add Member (by email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) pm.collectionVariables.set('memberId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@example.com\",\n  \"role\": \"MEMBER\"\n}"
            },
            "url": "{{baseUrl}}/organizations/{{orgId}}/members"
          }
        },
        {
          "name": "Add Member (by userId)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/organizations/{{orgId}}/members"
          }
        },
        {
          "name": "Update Member Role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"MANAGER\"\n}"
            },
            "url": "{{baseUrl}}/organizations/{{orgId}}/members/{{memberId}}"
          }
        },
        {
          "name": "Remove Member",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/organizations/{{orgId}}/members/{{memberId}}"
          }
        },
        {
          "name": "Leave Organization",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/organizations/{{orgId}}/leave"
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "Create Team",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) pm.collectionVariables.set('teamId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering\",\n  \"slug\": \"engineering\",\n  \"description\": \"Product engineering team\"\n}"
            },
            "url": "{{baseUrl}}/organizations/{{orgId}}/teams"
          }
        },
        {
          "name": "List Teams",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations/{{orgId}}/teams"
          }
        },
        {
          "name": "Get Team",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations/{{orgId}}/teams/{{teamId}}"
          }
        },
        {
          "name": "Update Team",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering Team\",\n  \"description\": \"Updated team description\"\n}"
            },
            "url": "{{baseUrl}}/organizations/{{orgId}}/teams/{{teamId}}"
          }
        },
        {
          "name": "Delete Team",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/organizations/{{orgId}}/teams/{{teamId}}"
          }
        },
        {
          "name": "Add Team Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) pm.collectionVariables.set('teamMemberId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"role\": \"MEMBER\"\n}"
            },
            "url": "{{baseUrl}}/organizations/{{orgId}}/teams/{{teamId}}/members"
          }
        },
        {
          "name": "Update Team Member Role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"LEAD\"\n}"
            },
            "url": "{{baseUrl}}/organizations/{{orgId}}/teams/{{teamId}}/members/{{teamMemberId}}"
          }
        },
        {
          "name": "Remove Team Member",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/organizations/{{orgId}}/teams/{{teamId}}/members/{{teamMemberId}}"
          }
        }
      ]
    }
  ]
}
