<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Account</title>
</head>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
    href="https://fonts.googleapis.com/css2?family=Exo:ital,wght@0,100..900;1,100..900&family=Oswald:wght@200..700&display=swap"
    rel="stylesheet">

<body style="margin:0;padding:0;background:#f5f5f5;font-family:'Exo',Arial,Helvetica,sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background:#f5f5f5;padding:32px 16px;">
        <tr>
            <td align="center">

                <table width="600" cellpadding="0" cellspacing="0"
                    style="max-width:600px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e8e8e8;">

                    <!-- Header -->
                    <tr>
                        <td style="padding:28px 32px 24px;border-bottom:1px solid #f0f0f0;">
                            <table width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td align="left" valign="middle">
                                        <p
                                            style="margin:0;font-size:20px;font-weight:bold;color:#27bd90;letter-spacing:-0.3px;">
                                            {{appName}}
                                        </p>
                                    </td>
                                    <td align="right" valign="middle">
                                        <span
                                            style="display:inline-block;background:#27bd90;color:#ffffff;font-size:11px;font-weight:bold;letter-spacing:0.6px;text-transform:uppercase;padding:6px 12px;border-radius:999px;">
                                            Verify Email
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Hero -->
                    <tr>
                        <td style="padding:36px 32px 8px;">
                            <h1
                                style="margin:0 0 12px;font-size:26px;font-weight:bold;color:#27bd90;line-height:1.3;letter-spacing:-0.4px;">
                                Confirm your email
                            </h1>
                            <p style="margin:0;font-size:16px;color:#555555;line-height:1.6;">
                                Hi <strong style="color:#27bd90;">{{name}}</strong>, one quick step left before you can
                                sign in.
                            </p>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td style="padding:8px 32px 32px;">

                            <p style="margin:0 0 28px;font-size:15px;color:#666666;line-height:1.7;">
                                Tap the button below to verify your email address and activate your account.
                            </p>

                            <!-- CTA -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:28px;">
                                <tr>
                                    <td align="center">
                                        <a href="{{verificationUrl}}"
                                            style="display:inline-block;background:#27bd90;color:#ffffff;text-decoration:none;font-size:15px;font-weight:bold;padding:15px 36px;border-radius:8px;letter-spacing:0.2px;">
                                            Verify Account
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <!-- URL fallback box -->
                            <table width="100%" cellpadding="0" cellspacing="0"
                                style="background:#fafafa;border:1px solid #ececec;border-radius:8px;margin-bottom:28px;">
                                <tr>
                                    <td style="padding:16px 18px;">
                                        <p
                                            style="margin:0 0 8px;font-size:12px;font-weight:bold;color:#888888;text-transform:uppercase;letter-spacing:0.5px;">
                                            Or copy this link
                                        </p>
                                        <p
                                            style="margin:0;word-break:break-all;font-size:13px;color:#27bd90;line-height:1.5;">
                                            {{verificationUrl}}
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <!-- Meta info -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #f0f0f0;">
                                <tr>
                                    <td style="padding-top:24px;">
                                        <p style="margin:0 0 10px;font-size:13px;color:#888888;line-height:1.6;">
                                            This link expires in <strong style="color:#27bd90;">{{expiry}}</strong>.
                                        </p>
                                        <p style="margin:0;font-size:13px;color:#888888;line-height:1.6;">
                                            Didn't create an account? You can safely ignore this email.
                                        </p>
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td
                            style="background:#fafafa;padding:20px 32px;border-top:1px solid #f0f0f0;text-align:center;">
                            <p style="margin:0;font-size:12px;color:#aaaaaa;">
                                © {{year}} {{appName}} · All rights reserved
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>